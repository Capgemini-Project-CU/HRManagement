@model ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<section class="profile-panel">
    <div class="profile-avatar">HR</div>
    <div>
        <p class="eyebrow">Signed in user</p>
        <h2>@Model.Email</h2>
        <div class="profile-meta">
            <span>@Model.Role</span>
            @if (!string.IsNullOrWhiteSpace(Model.EmployeeId))
            {
                <span>Employee @Model.EmployeeId</span>
            }
        </div>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Warning))
{
    <div class="alert alert-info border-0 shadow-sm mt-4">@Model.Warning</div>
}
