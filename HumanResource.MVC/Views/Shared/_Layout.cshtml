@inject ResourceCatalog Catalog
@{
    var role = Context.Session.GetString("UserRole") ?? string.Empty;
    var email = Context.Session.GetString("UserEmail") ?? string.Empty;
    var signedIn = !string.IsNullOrWhiteSpace(Context.Session.GetString("JwtToken"));
    var authScreen = ViewData["AuthScreen"] as bool? == true;
    var title = ViewData["Title"]?.ToString() ?? "HR Management System";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - HR Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(signedIn && !authScreen ? "app-shell" : "auth-shell")">
    @if (signedIn && !authScreen)
    {
        <aside class="sidebar" id="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">HR</span>
                <span>
                    <strong>HR Management System</strong>
                </span>
            </a>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index"><span>Dashboard</span></a>
                @if (string.Equals(role, "Manager", StringComparison.OrdinalIgnoreCase))
                {
                    <a asp-controller="Resources" asp-action="MyTeam"><span>My Team</span></a>
                }
                @foreach (var resource in Catalog.All.Where(item => Catalog.IsAllowed(role, item.ViewRoles)))
                {
                    <a asp-controller="Resources" asp-action="Index" asp-route-key="@resource.Key">
                        <span>@resource.Title</span>
                    </a>
                }
                <a asp-controller="Home" asp-action="Profile"><span>Profile</span></a>
            </nav>
        </aside>

        <div class="main-panel">
            <header class="topbar">
                <div>
                    <p class="eyebrow">HR Management System</p>
                    <h1>@title</h1>
                </div>
                <div class="topbar-actions">
                    <div class="user-chip">
                        <span>@(string.IsNullOrWhiteSpace(email) ? "User" : email)</span>
                        <strong>@role</strong>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="icon-button danger" type="submit" title="Sign out" aria-label="Sign out">
                            <span>Exit</span>
                        </button>
                    </form>
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="auth-page">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
