@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<section class="auth-card wide">
    <div class="auth-brand">
        <span>HR</span>
        <div>
            <strong>Create Account</strong>
            <small>Sent to api/Auth/register</small>
        </div>
    </div>

    <h1>Register employee</h1>

    <form asp-action="Register" method="post" class="stacked-form two-column">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger grid-full"></div>

        <div>
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="LastName"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="PhoneNumber"></label>
            <input asp-for="PhoneNumber" class="form-control" />
        </div>
        <div>
            <label asp-for="JobId"></label>
            <input asp-for="JobId" class="form-control" />
            <span asp-validation-for="JobId" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="Salary"></label>
            <input asp-for="Salary" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="Salary" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="DepartmentId"></label>
            <input asp-for="DepartmentId" class="form-control" type="number" step="1" />
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>
        <div>
            <label asp-for="ManagerId"></label>
            <input asp-for="ManagerId" class="form-control" type="number" step="1" />
        </div>
        <div>
            <label asp-for="RoleId"></label>
            <input asp-for="RoleId" class="form-control" type="number" step="1" />
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>

        <div class="grid-full d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit">
                Create account
            </button>
            <a class="btn btn-outline-secondary" asp-action="Login">Back</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
