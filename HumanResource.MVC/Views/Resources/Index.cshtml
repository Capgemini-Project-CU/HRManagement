@model ResourcePageViewModel
@{
    ViewData["Title"] = Model.Resource.Title;
    var tableFields = Model.Resource.Fields.Where(field => field.ShowInTable).ToList();
    var createFields = Model.Resource.Fields.Where(field => !field.ReadOnly && field.ShowInCreate).ToList();
    var editFields = Model.Resource.Fields.Where(field => !field.ReadOnly && field.ShowInEdit).ToList();
}

@functions {
    private static string Value(System.Text.Json.JsonElement row, string name)
    {
        if (string.Equals(name, "fullName", StringComparison.OrdinalIgnoreCase))
        {
            return string.Join(" ", new[] { Value(row, "firstName"), Value(row, "lastName") }.Where(part => !string.IsNullOrWhiteSpace(part)));
        }

        if (row.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            return string.Empty;
        }

        return row.TryGetProperty(name, out var value) ? Display(value) : string.Empty;
    }

    private static string Display(System.Text.Json.JsonElement value)
    {
        return value.ValueKind switch
        {
            System.Text.Json.JsonValueKind.Array => string.Join(", ", value.EnumerateArray().Select(Display)),
            System.Text.Json.JsonValueKind.Null => string.Empty,
            _ => value.ToString()
        };
    }

    private static string DisplayValue(ResourcePageViewModel model, System.Text.Json.JsonElement row, ApiField field)
    {
        var value = Value(row, field.Name);

        if (string.IsNullOrWhiteSpace(field.LookupKey) || string.IsNullOrWhiteSpace(value))
        {
            return value;
        }

        return model.LookupOptions.TryGetValue(field.LookupKey, out var options)
            ? options.FirstOrDefault(option => string.Equals(option.Value, value, StringComparison.OrdinalIgnoreCase))?.Text ?? value
            : value;
    }

    private static string InputType(ApiField field)
    {
        return field.Type switch
        {
            ApiFieldType.Password => "password",
            ApiFieldType.Number => "number",
            ApiFieldType.Date => "date",
            _ => "text"
        };
    }

    private static string InputValue(System.Text.Json.JsonElement row, ApiField field)
    {
        var value = Value(row, field.Name);
        return field.Type == ApiFieldType.Date && value.Length >= 10 ? value[..10] : value;
    }
}

<section class="module-header">
    <div>
        <p class="eyebrow">Module</p>
        <h2>@Model.Resource.Title</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Resource.Summary))
        {
            <span>@Model.Resource.Summary</span>
        }
    </div>
    @if (Model.CanCreate)
    {
        <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#createModal">
            Add record
        </button>
    }
</section>

@if (!string.IsNullOrWhiteSpace(Model.Notice))
{
    <div class="alert alert-success border-0 shadow-sm">@Model.Notice</div>
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger border-0 shadow-sm">@Model.Error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.ActiveFilterTitle))
{
    <div class="alert alert-info border-0 shadow-sm">
        Showing result for <strong>@Model.ActiveFilterTitle</strong>.
        <a asp-controller="Resources" asp-action="Index" asp-route-key="@Model.Resource.Key" class="ms-2">Clear</a>
    </div>
}

@if (Model.Resource.Filters.Count > 0)
{
    <section class="filter-strip">
        @foreach (var filter in Model.Resource.Filters)
        {
            <form asp-controller="Resources" asp-action="Filter" asp-route-key="@Model.Resource.Key" asp-route-filterKey="@filter.Key" method="post" class="filter-form">
                @Html.AntiForgeryToken()
                <strong>@filter.Title</strong>
                @foreach (var field in filter.Fields)
                {
                    if (!string.IsNullOrWhiteSpace(field.LookupKey) && Model.LookupOptions.TryGetValue(field.LookupKey, out var options))
                    {
                        <div class="select-wrap compact">
                            <select class="form-select form-select-sm" name="@field.Name" required="@(field.Required ? "required" : null)">
                                <option value="">Select @field.Label</option>
                                @foreach (var option in options)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input class="form-control form-control-sm" name="@field.Name" type="@InputType(field)" placeholder="@field.Label" required="@(field.Required ? "required" : null)" />
                    }
                }
                <button class="btn btn-outline-primary btn-sm" type="submit">Apply</button>
            </form>
        }
    </section>
}

<section class="panel">
    <div class="table-responsive">
        <table class="table align-middle resource-table">
            <thead>
                <tr>
                    @foreach (var field in tableFields)
                    {
                        <th>@field.Label</th>
                    }
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Records.Count == 0)
                {
                    <tr>
                        <td colspan="@(tableFields.Count + 1)" class="text-center text-muted py-5">No records found.</td>
                    </tr>
                }
                @for (var index = 0; index < Model.Records.Count; index++)
                {
                    var row = Model.Records[index];
                    var id = Value(row, Model.Resource.IdField);
                    <tr>
                        @foreach (var field in tableFields)
                        {
                            var value = DisplayValue(Model, row, field);
                            <td>@(string.IsNullOrWhiteSpace(value) ? "-" : value)</td>
                        }
                        <td class="text-end">
                            <div class="row-actions">
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="modal" data-bs-target="#viewModal@index">
                                    View
                                </button>
                                @if (Model.CanEdit && !string.IsNullOrWhiteSpace(id))
                                {
                                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="modal" data-bs-target="#editModal@index">
                                        Edit
                                    </button>
                                }
                                @if (Model.CanDelete && !string.IsNullOrWhiteSpace(id))
                                {
                                    <form asp-controller="Resources" asp-action="Delete" asp-route-key="@Model.Resource.Key" asp-route-id="@id" method="post" onsubmit="return confirm('Delete this record?');">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@if (Model.CanCreate)
{
    <div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Resources" asp-action="Create" asp-route-key="@Model.Resource.Key" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">Add @Model.Resource.Title</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body form-grid">
                        @foreach (var field in createFields)
                        {
                            <div>
                                <label class="form-label" for="create-@field.Name">@field.Label</label>
                                @if (!string.IsNullOrWhiteSpace(field.LookupKey) && Model.LookupOptions.TryGetValue(field.LookupKey, out var options))
                                {
                                    <div class="select-wrap">
                                        <select id="create-@field.Name" name="@field.Name" class="form-select" required="@(field.Required ? "required" : null)">
                                            <option value="">Select @field.Label</option>
                                            @foreach (var option in options)
                                            {
                                                <option value="@option.Value">@option.Text</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <input id="create-@field.Name" name="@field.Name" type="@InputType(field)" class="form-control" required="@(field.Required ? "required" : null)" step="@(field.Type == ApiFieldType.Number ? "0.01" : null)" />
                                }
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@for (var index = 0; index < Model.Records.Count; index++)
{
    var row = Model.Records[index];
    var id = Value(row, Model.Resource.IdField);

    <div class="modal fade" id="viewModal@index" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Model.Resource.Title details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body detail-grid">
                    @foreach (var field in Model.Resource.Fields.Where(field => field.ShowInTable || !field.ReadOnly))
                    {
                        var value = DisplayValue(Model, row, field);
                        <div>
                            <span>@field.Label</span>
                            <strong>@(string.IsNullOrWhiteSpace(value) ? "-" : value)</strong>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (Model.CanEdit && !string.IsNullOrWhiteSpace(id))
    {
        <div class="modal fade" id="editModal@index" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Resources" asp-action="Update" asp-route-key="@Model.Resource.Key" asp-route-id="@id" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title">Edit @Model.Resource.Title</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body form-grid">
                            @foreach (var field in editFields)
                            {
                                var currentValue = InputValue(row, field);
                                <div>
                                    <label class="form-label" for="edit-@index-@field.Name">@field.Label</label>
                                    @if (!string.IsNullOrWhiteSpace(field.LookupKey) && Model.LookupOptions.TryGetValue(field.LookupKey, out var options))
                                    {
                                        <div class="select-wrap">
                                            <select id="edit-@index-@field.Name" name="@field.Name" class="form-select" required="@(field.Required ? "required" : null)">
                                                <option value="">Select @field.Label</option>
                                                @foreach (var option in options)
                                                {
                                                    <option value="@option.Value" selected="@(string.Equals(option.Value, currentValue, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Text</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                    else
                                    {
                                        <input id="edit-@index-@field.Name" name="@field.Name" value="@currentValue" type="@InputType(field)" class="form-control" required="@(field.Required ? "required" : null)" step="@(field.Type == ApiFieldType.Number ? "0.01" : null)" />
                                    }
                                </div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Update</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
