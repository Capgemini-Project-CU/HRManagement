@model ResourceEditViewModel
@{
    ViewData["Title"] = $"Edit {Model.Resource.Title}";
    var editFields = Model.Resource.Fields.Where(field => !field.ReadOnly && field.ShowInEdit).ToList();
}

@functions {
    private static string InputType(ApiField field)
    {
        return field.Type switch
        {
            ApiFieldType.Password => "password",
            ApiFieldType.Number => "number",
            ApiFieldType.Date => "date",
            ApiFieldType.Email => "email",
            ApiFieldType.Phone => "tel",
            _ => "text"
        };
    }
}

<section class="module-header">
    <div>
        <p class="eyebrow">Edit</p>
        <h2>@Model.Resource.Title</h2>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Back</a>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger border-0 shadow-sm">@Model.Error</div>
}

<section class="panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="form-grid">
            @foreach (var field in editFields)
            {
                var value = Model.Values.TryGetValue(field.Name, out var currentValue) ? currentValue : string.Empty;
                <div>
                    <label class="form-label" for="edit-@field.Name">@field.Label</label>
                    @if (!string.IsNullOrWhiteSpace(field.LookupKey) && Model.LookupOptions.TryGetValue(field.LookupKey, out var options))
                    {
                        <div class="select-wrap">
                            <select id="edit-@field.Name" name="@field.Name" class="form-select" required="@(field.Required ? "required" : null)">
                                <option value="">Select @field.Label</option>
                                @foreach (var option in options)
                                {
                                    <option value="@option.Value" selected="@(string.Equals(option.Value, value, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@option.Text</option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <input id="edit-@field.Name" name="@field.Name" value="@value" type="@InputType(field)" class="form-control" required="@(field.Required ? "required" : null)" step="@(field.Type == ApiFieldType.Number ? "0.01" : null)" pattern="@field.Pattern" title="@field.ValidationMessage" />
                    }
                </div>
            }
        </div>
        <div class="form-actions">
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
            <button type="submit" class="btn btn-primary">Update</button>
        </div>
    </form>
</section>

